datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & NEXTAUTH (100% WHITE-LABEL GOOGLE OAUTH)
// -------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          String       @default("user") // "user" | "admin" | "vendor"
  package       String       @default("free") // "free" | "diamond" | "royal" | "physical"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -------------------------------------------------------------
// WEDDING INVITATION DATA MODELS
// -------------------------------------------------------------

model Invitation {
  id             String      @id @default(cuid())
  userId         String      @map("user_id")
  slug           String      @unique
  title          String      @default("Pernikahan Dimas & Clarissa")
  groomName      String      @default("Dimas")
  brideName      String      @default("Clarissa")
  eventDate      DateTime?
  eventCity      String      @default("Bandar Lampung")
  culturalTheme  String      @default("modern") // "modern" | "jawa" | "minang" | "botanical"
  colorTheme     String      @default("dark")   // "dark" | "light"
  audioTrack     String      @default("modern")
  isPublished    Boolean     @default(true)
  viewsCount     Int         @default(0)
  
  // JSON payload storing pages, custom elements, watermarks
  pagesData      String      @db.Text
  customElements String?     @db.Text
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests         Guest[]
  wishes         RsvpWish[]
  payments       Payment[]

  @@map("invitations")
}

model Guest {
  id           String      @id @default(cuid())
  invitationId String      @map("invitation_id")
  name         String
  phone        String
  category     String      @default("Teman") // "VIP" | "Keluarga" | "Teman" | "Kolega"
  status       String      @default("pending") // "pending" | "sent" | "delivered" | "read"
  sentAt       String?
  notes        String?
  createdAt    DateTime    @default(now())

  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("guests")
}

model RsvpWish {
  id           String      @id @default(cuid())
  invitationId String      @map("invitation_id")
  name         String
  status       String      @default("hadir") // "hadir" | "tidak" | "ragu"
  guestsCount  String      @default("1 Orang")
  message      String      @db.Text
  createdAt    DateTime    @default(now())

  invitation   Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvp_wishes")
}

model Payment {
  id            String      @id @default(cuid())
  invitationId  String      @map("invitation_id")
  orderId       String      @unique @map("order_id")
  amount        Int
  status        String      @default("pending") // "pending" | "success" | "expired"
  paymentMethod String      @default("qris")    // "qris" | "shopeepay" | "bca" | "mandiri"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  invitation    Invitation  @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

